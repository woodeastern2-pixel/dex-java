<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="196dp" android:layout_height="wrap_content" android:layout_marginEnd="10dp"
    app:cardBackgroundColor="@color/surface_card" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/stroke_soft" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <ImageView android:id="@+id/ivThumb" android:layout_width="match_parent" android:layout_height="100dp" android:background="@drawable/bg_photo_slot" android:clipToOutline="true" android:contentDescription="@null" android:scaleType="centerCrop" android:visibility="gone" />
        <TextView android:id="@+id/tvName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="@color/charcoal" android:textSize="15sp" />
        <TextView android:id="@+id/tvLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/navy_accent" android:textSize="13sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
