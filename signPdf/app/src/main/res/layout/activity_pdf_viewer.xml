<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPageBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/colorToolbar"
        android:elevation="1dp"
        android:paddingEnd="8dp"
        app:titleTextColor="@color/colorTextPrimary"
        app:navigationIconTint="@color/colorTextPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/progress_saving"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_share"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                android:contentDescription="@string/share"
                app:tint="@color/colorTextPrimary" />

            <ImageButton
                android:id="@+id/btn_save"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_save"
                android:contentDescription="@string/save"
                app:tint="@color/colorPrimary" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <FrameLayout
        android:id="@+id/pdf_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_editor_canvas"
        android:clipToOutline="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.signpdf.app.viewer.PdfRenderView
            android:id="@+id/pdf_render_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.signpdf.app.viewer.AnnotationLayerView
            android:id="@+id/annotation_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/page_nav_bar"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_page_chip"
        android:elevation="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_prev_page"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="@string/previous_page"
            app:tint="@color/colorTextPrimary" />

        <TextView
            android:id="@+id/tv_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="72dp"
            android:gravity="center"
            android:text="@string/page_indicator_initial"
            android:textColor="@color/colorTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_next_page"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="@string/next_page"
            app:tint="@color/colorTextPrimary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_editor_panel"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/bottom_panel_handle"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/toggle_bottom_panel">
            <View
                android:id="@+id/bottom_panel_grip"
                android:layout_width="42dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/bottom_panel_grip_bg" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageButton
                android:id="@+id/color_btn_0"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/color_black" />
            <ImageButton
                android:id="@+id/color_btn_1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/color_blue" />
            <ImageButton
                android:id="@+id/color_btn_2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/color_red" />
            <ImageButton
                android:id="@+id/color_btn_3"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/color_green" />
            <ImageButton
                android:id="@+id/color_btn_4"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/color_gray" />
            <ImageButton
                android:id="@+id/color_btn_5"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/color_white" />
            <ImageButton
                android:id="@+id/color_btn_6"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/color_yellow" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <View
                android:id="@+id/view_pen_preview"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="10dp" />

            <SeekBar
                android:id="@+id/seek_stroke_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="29"
                android:progress="3"
                android:progressTint="@color/colorPrimary"
                android:thumbTint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tv_stroke_size_value"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/stroke_size_initial"
                android:textColor="@color/colorTextPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_undo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_undo"
                android:contentDescription="@string/undo"
                app:tint="@color/colorTextPrimary" />

            <ImageButton
                android:id="@+id/btn_redo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_redo"
                android:contentDescription="@string/redo"
                app:tint="@color/colorTextPrimary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageButton android:id="@+id/btn_pen" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginHorizontal="3dp" android:background="@drawable/tool_button_bg" android:src="@drawable/ic_pen" android:contentDescription="@string/pen" app:tint="@color/colorTextPrimary" />
            <ImageButton android:id="@+id/btn_pencil" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginHorizontal="3dp" android:background="@drawable/tool_button_bg" android:src="@drawable/ic_pencil" android:contentDescription="@string/pencil" app:tint="@color/colorTextPrimary" />
            <ImageButton android:id="@+id/btn_highlighter" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginHorizontal="3dp" android:background="@drawable/tool_button_bg" android:src="@drawable/ic_highlighter" android:contentDescription="@string/highlighter" app:tint="@color/colorTextPrimary" />
            <ImageButton android:id="@+id/btn_eraser" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginHorizontal="3dp" android:background="@drawable/tool_button_bg" android:src="@drawable/ic_eraser" android:contentDescription="@string/eraser" app:tint="@color/colorTextPrimary" />
            <ImageButton android:id="@+id/btn_pan" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginHorizontal="3dp" android:background="@drawable/tool_button_bg" android:src="@drawable/ic_pan" android:contentDescription="@string/pan" app:tint="@color/colorTextPrimary" />
            <ImageButton android:id="@+id/btn_select_area" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginHorizontal="3dp" android:background="@drawable/tool_button_bg" android:src="@drawable/ic_signature" android:contentDescription="@string/select_area" app:tint="@color/colorTextPrimary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_bottom"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="@string/save"
                android:textColor="@color/colorTextOnPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_save"
                app:iconTint="@color/colorTextOnPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_bottom"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/share"
                android:textColor="@color/colorPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/colorPrimary"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
