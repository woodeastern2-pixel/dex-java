+        content TEXT NOT NULL,
+        category TEXT NOT NULL,
+        customer TEXT NOT NULL,
+        project TEXT NOT NULL,
+        priority TEXT NOT NULL DEFAULT 'MEDIUM',
+        status TEXT NOT NULL DEFAULT 'OPEN',
+        ai_category TEXT,
