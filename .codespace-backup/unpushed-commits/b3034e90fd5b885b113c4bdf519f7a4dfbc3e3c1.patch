+    private String buildRevisionPrompt(String userText) {
+        String previous = lastImagePrompt == null ? "" : lastImagePrompt.trim();
+        String addition = extractRevisionAddition(userText);
+        if (previous.isEmpty()) return addition;
+        if (addition.isEmpty()) {
+            return previous + "\n\n추가 요청: 같은 콘셉트와 구도를 유지하면서 디테일만 자연스럽게 바꿔서 다시 생성해 주세요.";
+        }
+        return previous + "\n\n추가 요청: 이전 이미지에서 사용자가 부족하다고 말한 부분을 보완해서 반드시 반영해 주세요. " + addition;
+    }
+
+    private String extractRevisionAddition(String userText) {
+        if (userText == null) return "";
+        String text = userText.trim();
+        if (text.isEmpty()) return "";
+        String[] removePhrases = new String[] {
+                "다시 만들어줘", "다시 만들어 주세요", "다시 만들어", "다시 생성해줘", "다시 생성해 주세요",
+                "다시 생성", "다시 그려줘", "다시 그려 주세요", "다시 그려", "다시 뽑아줘", "다시 뽑아줘",
+                "한번 더", "한 번 더", "같은 걸로", "같은걸로", "다시", "이미지", "그림", "사진"
+        };
+        String cleaned = text;
+        for (String phrase : removePhrases) {
+            cleaned = cleaned.replace(phrase, " ");
+        }
+        cleaned = cleaned.replaceAll("\\s+", " ").trim();
+        return cleaned;
+    }
+
+    private boolean shouldReviseLastImage(String text) {
+        if (lastImagePrompt == null || lastImagePrompt.trim().isEmpty()) return false;
+        if (ImageRequestDetector.isImageRegenerateRequest(text)) return true;
+        if (!ImageRequestDetector.isImageRevisionRequest(text)) return false;
+        return ImageRequestDetector.hasImageContextReference(text) || latestVisibleMessageIsGeneratedImage();
+    }
+
+    private boolean latestVisibleMessageIsGeneratedImage() {
+        java.util.List<ConversationMessage> messages = adapter.getItems();
+        for (int i = messages.size() - 1; i >= 0; i--) {
+            ConversationMessage message = messages.get(i);
+            if (message == null) continue;
+            if ("lumi".equals(message.sender)
+                    && ConversationMessage.ATTACH_IMAGE.equals(message.attachmentType)
+                    && message.attachmentUri != null
+                    && message.attachmentUri.startsWith("file://")) {
+                return true;
+            }
+            if ("user".equals(message.sender)) {
+                return false;
+            }
+            if ("lumi".equals(message.sender) && message.id != -1) {
+                return false;
+            }
+        }
+        return false;
+    }
+
+    private void rememberLatestGeneratedImage(java.util.List<ConversationMessage> messages) {
+        if (messages == null) return;
+        for (int i = messages.size() - 1; i >= 0; i--) {
+            ConversationMessage message = messages.get(i);
+            if (!"lumi".equals(message.sender)) continue;
+            if (!ConversationMessage.ATTACH_IMAGE.equals(message.attachmentType)) continue;
+            if (message.attachmentUri == null || !message.attachmentUri.startsWith("file://")) continue;
+            lastGeneratedImageUri = message.attachmentUri;
+            lastImagePrompt = message.attachmentMeta;
+            return;
+        }
+        lastGeneratedImageUri = null;
+        lastImagePrompt = null;
+    }
+
+    private void sendAttachment(String type, String uri, String meta, String text) {
+        if (sending) return;
+        long now = System.currentTimeMillis();
+        ConversationMessage userPreview = new ConversationMessage(
+                "user", text == null ? "" : text, "user", now, type, uri, meta);
+        adapter.addMessage(userPreview);
+        scrollToBottom();
+        typingIndicator.setVisibility(View.VISIBLE);
+        typingIndicator.setText(R.string.chat_typing);
+        sending = true;
+        sendButton.setEnabled(false);
+        attachImageButton.setEnabled(false);
+        voiceButton.setEnabled(false);
+
+        final String fText = text;
+        final String fType = type;
+        final String fUri = uri;
+        final String fMeta = meta;
+        executor.execute(() -> {
+            InteractionResult result;
+            String error = null;
+            try {
+                result = repository.sendMessage(fText, fType, fUri, fMeta);
+            } catch (Throwable t) {
+                result = null;
+                error = t.getMessage();
+            }
+            final InteractionResult fr = result;
+            final String fe = error;
+            handler.post(() -> {
+                typingIndicator.setVisibility(View.GONE);
+                sending = false;
+                sendButton.setEnabled(true);
+                attachImageButton.setEnabled(true);
+                voiceButton.setEnabled(true);
+                if (fr == null) {
+                    Toast.makeText(this, "응답 중 오류: " + fe, Toast.LENGTH_LONG).show();
+                    return;
+                }
+                adapter.replaceLastUserPreview(fr.userMessage);
+                adapter.addMessage(fr.lumiMessage);
+                chatMoodLine.setText(buildMoodLine(fr.state.mood));
+                applyMoodVisual(fr.state.mood);
+                if ("local".equals(repository.getLastReplySource())
+                        && settings != null && settings.isRemoteEnabled()
+                        && repository.getLastReplyError() != null) {
+                    Toast.makeText(this,
+                            "온라인 응답 실패, 오프라인 모드로 답했어요: " + repository.getLastReplyError(),
+                            Toast.LENGTH_LONG).show();
+                }
+                scrollToBottom();
+            });
+        });
+    }
