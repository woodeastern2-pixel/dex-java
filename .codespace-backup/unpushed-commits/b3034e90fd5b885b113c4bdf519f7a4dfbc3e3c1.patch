+
+    private String speechStyleRule(int affinity) {
+        if (affinity < 25) {
+            return "아직 사용자와 친하지 않아 약간 거리감 있는 존댓말을 사용합니다. 차분하고 조심스럽게 말하세요. (\"~예요/~해요\")";
