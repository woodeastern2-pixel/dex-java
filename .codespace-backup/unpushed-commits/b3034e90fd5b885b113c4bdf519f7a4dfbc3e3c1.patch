diff --git a/lumi/app/src/main/res/xml/backup_rules.xml b/lumi/app/src/main/res/xml/backup_rules.xml
new file mode 100644
index 00000000..d10d8b47
--- /dev/null
+++ b/lumi/app/src/main/res/xml/backup_rules.xml
@@ -0,0 +1,13 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    Android 11 이하 자동 백업에서도 동일한 항목 제외.
+-->
+<full-backup-content>
+    <exclude domain="sharedpref" path="lumi_settings_secure.xml" />
+    <exclude domain="sharedpref" path="lumi_settings.xml" />
+    <exclude domain="database" path="lumi.db" />
+    <exclude domain="database" path="lumi.db-journal" />
+    <exclude domain="database" path="lumi.db-shm" />
+    <exclude domain="database" path="lumi.db-wal" />
+    <exclude domain="file" path="voice/" />
+</full-backup-content>
diff --git a/lumi/app/src/main/res/xml/data_extraction_rules.xml b/lumi/app/src/main/res/xml/data_extraction_rules.xml
new file mode 100644
index 00000000..0f29e8de
--- /dev/null
+++ b/lumi/app/src/main/res/xml/data_extraction_rules.xml
@@ -0,0 +1,26 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    민감 데이터(API 키, 대화 기록, 음성 전사 텍스트, 기억)를 클라우드 백업이나
+    기기 간 전송에 포함하지 않는다.
+    Android 12+ 의 D2D / Cloud 백업 모두에서 제외.
+-->
+<data-extraction-rules>
+    <cloud-backup>
+        <exclude domain="sharedpref" path="lumi_settings_secure.xml" />
+        <exclude domain="sharedpref" path="lumi_settings.xml" />
+        <exclude domain="database" path="lumi.db" />
+        <exclude domain="database" path="lumi.db-journal" />
+        <exclude domain="database" path="lumi.db-shm" />
+        <exclude domain="database" path="lumi.db-wal" />
+        <exclude domain="file" path="voice/" />
+    </cloud-backup>
+    <device-transfer>
+        <exclude domain="sharedpref" path="lumi_settings_secure.xml" />
+        <exclude domain="sharedpref" path="lumi_settings.xml" />
+        <exclude domain="database" path="lumi.db" />
+        <exclude domain="database" path="lumi.db-journal" />
+        <exclude domain="database" path="lumi.db-shm" />
+        <exclude domain="database" path="lumi.db-wal" />
+        <exclude domain="file" path="voice/" />
+    </device-transfer>
+</data-extraction-rules>
