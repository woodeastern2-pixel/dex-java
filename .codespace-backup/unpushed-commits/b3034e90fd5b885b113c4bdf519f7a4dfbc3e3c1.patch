+    public static Intent intent(Context c) {
+        return new Intent(c, ChatActivity.class);
+    }
+}
diff --git a/lumi/app/src/main/java/com/lumi/app/ui/ChatAdapter.java b/lumi/app/src/main/java/com/lumi/app/ui/ChatAdapter.java
