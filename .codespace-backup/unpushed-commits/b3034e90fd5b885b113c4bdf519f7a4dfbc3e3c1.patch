diff --git a/signPdf/app/src/main/res/layout/activity_main.xml b/signPdf/app/src/main/res/layout/activity_main.xml
new file mode 100644
index 00000000..4767d829
--- /dev/null
+++ b/signPdf/app/src/main/res/layout/activity_main.xml
@@ -0,0 +1,133 @@
+<?xml version="1.0" encoding="utf-8"?>
+<androidx.constraintlayout.widget.ConstraintLayout
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@color/colorBackground">
+
+    <!-- 상단 헤더 -->
+    <LinearLayout
+        android:id="@+id/header"
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:orientation="vertical"
+        android:background="@color/colorPrimary"
+        android:paddingTop="32dp"
+        android:paddingBottom="24dp"
+        android:paddingHorizontal="24dp"
+        app:layout_constraintTop_toTopOf="parent"
+        app:layout_constraintStart_toStartOf="parent"
+        app:layout_constraintEnd_toEndOf="parent">
+
+        <TextView
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:text="SignPDF"
+            android:textColor="@color/colorTextOnPrimary"
+            android:textSize="28sp"
+            android:textStyle="bold"
+            android:fontFamily="sans-serif-medium"/>
+
+        <TextView
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="4dp"
+            android:text="문서에 서명하고 필기하세요"
+            android:textColor="#BBDEFB"
+            android:textSize="14sp"/>
+
+    </LinearLayout>
+
+    <!-- 스크롤 영역 -->
+    <ScrollView
+        android:layout_width="0dp"
+        android:layout_height="0dp"
+        app:layout_constraintTop_toBottomOf="@id/header"
+        app:layout_constraintBottom_toBottomOf="parent"
+        app:layout_constraintStart_toStartOf="parent"
+        app:layout_constraintEnd_toEndOf="parent">
+
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="vertical"
+            android:padding="20dp">
+
+            <!-- 문서 불러오기 버튼 -->
+            <com.google.android.material.button.MaterialButton
+                android:id="@+id/btn_open_document"
+                android:layout_width="match_parent"
+                android:layout_height="64dp"
+                android:text="@string/open_document"
+                android:textSize="16sp"
+                android:textStyle="bold"
+                app:cornerRadius="12dp"
+                app:backgroundTint="@color/colorPrimary"
+                android:textColor="@color/colorTextOnPrimary"
+                app:icon="@drawable/ic_add"
+                app:iconGravity="textStart"
+                app:iconTint="@color/colorTextOnPrimary"/>
+
+            <!-- 지원 형식 안내 -->
+            <TextView
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="8dp"
+                android:layout_gravity="center_horizontal"
+                android:text="PDF · JPG · PNG · DOCX (변환 제한 있음)"
+                android:textColor="@color/colorTextSecondary"
+                android:textSize="12sp"/>
+
+            <!-- 진행 표시 -->
+            <ProgressBar
+                android:id="@+id/progress_loading"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_gravity="center_horizontal"
+                android:layout_marginTop="12dp"
+                android:visibility="gone"/>
+
+            <!-- 구분선 -->
+            <View
+                android:layout_width="match_parent"
+                android:layout_height="1dp"
+                android:layout_marginVertical="20dp"
+                android:background="@color/colorDivider"/>
+
+            <!-- 최근 파일 제목 -->
+            <TextView
+                android:id="@+id/tv_recent_title"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:text="@string/recent_files"
+                android:textColor="@color/colorTextPrimary"
+                android:textSize="16sp"
+                android:textStyle="bold"
+                android:visibility="gone"/>
+
+            <!-- 최근 파일 없음 안내 -->
+            <TextView
+                android:id="@+id/tv_no_recent_files"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="8dp"
+                android:text="@string/no_recent_files"
+                android:textColor="@color/colorTextSecondary"
+                android:textSize="14sp"
+                android:gravity="center"
+                android:paddingVertical="32dp"/>
+
+            <!-- 최근 파일 목록 -->
+            <androidx.recyclerview.widget.RecyclerView
+                android:id="@+id/rv_recent_files"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="8dp"
+                android:nestedScrollingEnabled="false"
+                android:visibility="gone"/>
+
+        </LinearLayout>
+    </ScrollView>
+
+</androidx.constraintlayout.widget.ConstraintLayout>
diff --git a/signPdf/app/src/main/res/layout/activity_pdf_viewer.xml b/signPdf/app/src/main/res/layout/activity_pdf_viewer.xml
new file mode 100644
index 00000000..8e86fe45
--- /dev/null
+++ b/signPdf/app/src/main/res/layout/activity_pdf_viewer.xml
@@ -0,0 +1,405 @@
+<?xml version="1.0" encoding="utf-8"?>
+<androidx.constraintlayout.widget.ConstraintLayout
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@color/colorPageBackground">
+
+    <!-- 상단 툴바 -->
+    <androidx.appcompat.widget.Toolbar
+        android:id="@+id/toolbar"
+        android:layout_width="0dp"
+        android:layout_height="?attr/actionBarSize"
+        android:background="@color/colorToolbar"
+        app:layout_constraintTop_toTopOf="parent"
+        app:layout_constraintStart_toStartOf="parent"
+        app:layout_constraintEnd_toEndOf="parent">
+
+        <!-- 저장 / 공유 버튼을 Toolbar 오른쪽에 배치 -->
+        <LinearLayout
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_gravity="end"
+            android:orientation="horizontal"
+            android:paddingEnd="8dp">
+
+            <ProgressBar
+                android:id="@+id/progress_saving"
+                android:layout_width="24dp"
+                android:layout_height="24dp"
+                android:layout_gravity="center_vertical"
+                android:layout_marginEnd="8dp"
+                android:visibility="gone"/>
+
+            <ImageButton
+                android:id="@+id/btn_save"
+                android:layout_width="40dp"
+                android:layout_height="40dp"
+                android:background="?attr/selectableItemBackgroundBorderless"
+                android:src="@drawable/ic_save"
+                android:contentDescription="@string/save"
+                android:tint="@color/colorTextOnPrimary"/>
+
+            <ImageButton
+                android:id="@+id/btn_share"
+                android:layout_width="40dp"
+                android:layout_height="40dp"
+                android:background="?attr/selectableItemBackgroundBorderless"
+                android:src="@drawable/ic_share"
+                android:contentDescription="@string/share"
+                android:tint="@color/colorTextOnPrimary"/>
+
+        </LinearLayout>
+    </androidx.appcompat.widget.Toolbar>
+
+    <!-- PDF 뷰 + 어노테이션 레이어 -->
+    <FrameLayout
+        android:id="@+id/pdf_container"
+        android:layout_width="0dp"
+        android:layout_height="0dp"
+        app:layout_constraintTop_toBottomOf="@id/toolbar"
+        app:layout_constraintBottom_toTopOf="@id/bottom_panel"
+        app:layout_constraintStart_toStartOf="parent"
+        app:layout_constraintEnd_toEndOf="parent">
+
+        <com.signpdf.app.viewer.PdfRenderView
+            android:id="@+id/pdf_render_view"
+            android:layout_width="match_parent"
+            android:layout_height="match_parent"/>
+
+        <com.signpdf.app.viewer.AnnotationLayerView
+            android:id="@+id/annotation_layer"
+            android:layout_width="match_parent"
+            android:layout_height="match_parent"/>
+
+    </FrameLayout>
+
+    <!-- 페이지 이동 오버레이 -->
+    <LinearLayout
+        android:id="@+id/page_nav_bar"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:orientation="horizontal"
+        android:background="#CC000000"
+        android:paddingHorizontal="8dp"
+        android:paddingVertical="4dp"
+        android:gravity="center_vertical"
+        app:layout_constraintBottom_toTopOf="@id/bottom_panel"
+        app:layout_constraintStart_toStartOf="parent"
+        app:layout_constraintEnd_toEndOf="parent"
+        android:layout_marginBottom="8dp">
+
+        <ImageButton
+            android:id="@+id/btn_prev_page"
+            android:layout_width="32dp"
+            android:layout_height="32dp"
+            android:background="?attr/selectableItemBackgroundBorderless"
+            android:src="@drawable/ic_chevron_left"
+            android:tint="#FFFFFF"/>
+
+        <TextView
+            android:id="@+id/tv_page_indicator"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:text="1 / 1"
+            android:textColor="#FFFFFF"
+            android:textSize="13sp"
+            android:paddingHorizontal="8dp"/>
+
+        <ImageButton
+            android:id="@+id/btn_next_page"
+            android:layout_width="32dp"
+            android:layout_height="32dp"
+            android:background="?attr/selectableItemBackgroundBorderless"
+            android:src="@drawable/ic_chevron_right"
+            android:tint="#FFFFFF"/>
+
+    </LinearLayout>
+
+    <!-- 하단 도구 패널 -->
+    <LinearLayout
+        android:id="@+id/bottom_panel"
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:orientation="vertical"
+        android:background="@color/colorBottomPanel"
+        android:elevation="8dp"
+        app:layout_constraintBottom_toBottomOf="parent"
+        app:layout_constraintStart_toStartOf="parent"
+        app:layout_constraintEnd_toEndOf="parent">
+
+        <FrameLayout
+            android:id="@+id/bottom_panel_handle"
+            android:layout_width="match_parent"
+            android:layout_height="28dp"
+            android:background="@color/colorBottomPanel"
+            android:clickable="true"
+            android:focusable="true"
+            android:contentDescription="@string/toggle_bottom_panel">
+
+            <View
+                android:id="@+id/bottom_panel_grip"
+                android:layout_width="44dp"
+                android:layout_height="4dp"
+                android:layout_gravity="center"
+                android:background="@drawable/bottom_panel_grip_bg" />
+
+        </FrameLayout>
+
+        <!-- 구분선 -->
+        <View
+            android:layout_width="match_parent"
+            android:layout_height="1dp"
+            android:background="@color/colorBottomPanelBorder"/>
+
+        <!-- 저장 / 공유 액션: 작은 화면에서도 명확하게 보이도록 텍스트 버튼 제공 -->
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="48dp"
+            android:orientation="horizontal"
+            android:gravity="center_vertical"
+            android:paddingHorizontal="12dp"
+            android:paddingTop="6dp"
+            android:paddingBottom="4dp">
+
+            <com.google.android.material.button.MaterialButton
+                android:id="@+id/btn_save_bottom"
+                android:layout_width="0dp"
+                android:layout_height="40dp"
+                android:layout_weight="1"
+                android:text="PDF 저장"
+                android:textSize="13sp"
+                android:textStyle="bold"
+                android:textColor="@color/colorTextOnPrimary"
+                app:backgroundTint="@color/colorPrimary"
+                app:cornerRadius="10dp"
+                app:icon="@drawable/ic_save"
+                app:iconTint="@color/colorTextOnPrimary" />
+
+            <com.google.android.material.button.MaterialButton
+                android:id="@+id/btn_share_bottom"
+                android:layout_width="0dp"
+                android:layout_height="40dp"
+                android:layout_marginStart="8dp"
+                android:layout_weight="1"
+                android:text="공유"
+                android:textSize="13sp"
+                android:textStyle="bold"
+                android:textColor="@color/colorPrimary"
+                app:backgroundTint="@color/colorSurface"
+                app:cornerRadius="10dp"
+                app:icon="@drawable/ic_share"
+                app:iconTint="@color/colorPrimary"
+                app:strokeColor="@color/colorPrimary"
+                app:strokeWidth="1dp" />
+
+        </LinearLayout>
+
+        <!-- 도구 버튼 행 -->
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="52dp"
+            android:orientation="horizontal"
+            android:gravity="center_vertical"
+            android:paddingHorizontal="8dp">
+
+            <ImageButton
+                android:id="@+id/btn_pen"
+                android:layout_width="44dp"
+                android:layout_height="44dp"
+                android:background="@drawable/tool_button_bg"
+                android:src="@drawable/ic_pen"
+                android:tint="@color/colorTextPrimary"
+                android:contentDescription="@string/pen"/>
+
+            <ImageButton
+                android:id="@+id/btn_pencil"
+                android:layout_width="44dp"
+                android:layout_height="44dp"
+                android:background="@drawable/tool_button_bg"
+                android:src="@drawable/ic_pencil"
+                android:tint="@color/colorTextPrimary"
+                android:contentDescription="@string/pencil"/>
+
+            <ImageButton
+                android:id="@+id/btn_highlighter"
+                android:layout_width="44dp"
+                android:layout_height="44dp"
+                android:background="@drawable/tool_button_bg"
+                android:src="@drawable/ic_highlighter"
+                android:tint="@color/colorTextPrimary"
+                android:contentDescription="@string/highlighter"/>
+
+            <ImageButton
+                android:id="@+id/btn_eraser"
+                android:layout_width="44dp"
+                android:layout_height="44dp"
+                android:background="@drawable/tool_button_bg"
+                android:src="@drawable/ic_eraser"
+                android:tint="@color/colorTextPrimary"
+                android:contentDescription="@string/eraser"/>
+
+            <ImageButton
+                android:id="@+id/btn_pan"
+                android:layout_width="44dp"
+                android:layout_height="44dp"
+                android:background="@drawable/tool_button_bg"
+                android:src="@drawable/ic_pan"
+                android:tint="@color/colorTextPrimary"
+                android:contentDescription="@string/pan"/>
+
+            <ImageButton
+                android:id="@+id/btn_select_area"
+                android:layout_width="44dp"
+                android:layout_height="44dp"
+                android:background="@drawable/tool_button_bg"
+                android:src="@drawable/ic_select_area"
+                android:tint="@color/colorTextPrimary"
+                android:contentDescription="@string/select_area"/>
+
+            <View
+                android:layout_width="0dp"
+                android:layout_height="0dp"
+                android:layout_weight="1"/>
+
+            <ImageButton
+                android:id="@+id/btn_undo"
+                android:layout_width="40dp"
