  'case "fall": specialSummary.setText(R.string.special_fall); break;',
  'case "belongings": specialSummary.setText(R.string.special_fall); break;'),
 ('app/src/main/java/com/easternwood/dolbomon/RecordActivity.java',
  'case "fever": specialSummary.setText(R.string.special_fever); break;',
