#!/usr/bin/env python3
from pathlib import Path
import sys, re, gzip, base64
root=Path(sys.argv[1])

def replace_once(rel, old, new):
    p=root/rel; s=p.read_text(); c=s.count(old)
    if c != 1: raise SystemExit(f"{rel}: expected one marker, got {c}: {old[:80]!r}")
    p.write_text(s.replace(old,new,1))

def set_string(rel, name, value):
    p=root/rel; s=p.read_text()
    pat=re.compile(r'(<string name="'+re.escape(name)+r'"[^>]*>)(.*?)(</string>)', re.S)
    s2,n=pat.subn(lambda m:m.group(1)+value+m.group(3),s,count=1)
    if n != 1: raise SystemExit(f"{rel}: string {name} not found")
    p.write_text(s2)

