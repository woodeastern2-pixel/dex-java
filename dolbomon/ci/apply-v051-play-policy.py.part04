               'additional_special_hint': '快速选择需要告知家属的日程、请求、用品等事项。',
               'more_special': '查看更多传达事项'}}

for loc,items in STRING_MAPS.items():
    rel=f"app/src/main/res/{loc}/strings.xml"
    for name,value in items.items(): set_string(rel,name,value)

sent=base64.b64decode('')
(root/'app/src/main/java/com/easternwood/dolbomon/SentenceGenerator.java').write_bytes(gzip.decompress(sent))
print(f"DolbomOn v0.5.1 daily-communication policy refactor applied at {root}")
