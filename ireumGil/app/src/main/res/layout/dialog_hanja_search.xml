<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/paper"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="아래 칸에 한 글자를 획순대로 크게 써 주세요. 인식 결과 중 등록 가능한 인명용 한자만 보여드립니다."
        android:textColor="@color/charcoal"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editReadingHint"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:hint="음 또는 뜻 힌트 (선택) · 예: 민, 옥돌"
        android:inputType="text"
        android:maxLines="1"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:textColor="@color/deep_navy"
        android:textSize="15sp" />

    <com.ireumgil.ui.HandwritingCanvasView
        android:id="@+id/handwritingCanvas"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_handwriting_canvas"
        android:contentDescription="한자를 손글씨로 쓰는 영역" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnUndoStroke"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_selection_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="한 획 취소"
            android:textColor="@color/deep_navy"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnClearCanvas"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_selection_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="전체 지우기"
            android:textColor="@color/deep_navy"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnRecognizeHandwriting"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_primary"
        android:text="손글씨 인식하기"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="한자를 쓴 뒤 인식하기를 눌러 주세요."
        android:textColor="@color/charcoal"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/listCandidates"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:divider="#00000000"
        android:dividerHeight="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone" />

</LinearLayout>
