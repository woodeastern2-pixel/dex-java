<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="이름 풀이"
            android:textColor="@color/deep_navy"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textGrade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:text="매우 좋음"
            android:textColor="@color/deep_navy"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="95"
            android:textColor="@color/deep_navy"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="8dp"
            android:text="점"
            android:textColor="@color/charcoal"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/textScoreMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="균형이 좋은 이름이에요"
        android:textColor="@color/charcoal"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressScore"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="16dp"
        android:max="100"
        android:progress="95"
        android:progressBackgroundTint="@color/outline"
        android:progressTint="@color/brand_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_mint_soft"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이름"
                android:textColor="@color/charcoal"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="서준"
                android:textColor="@color/deep_navy"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="44dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="18dp"
            android:background="@color/outline" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="한자"
                android:textColor="@color/charcoal"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textHanjaName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="瑞俊"
                android:textColor="@color/deep_navy"
                android:textSize="25sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/textScoreBreakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="3dp"
        android:text="사주·이름 오행 35/35 · 수리 28/30 · 음양 15/15 · 한자 데이터 20/20"
        android:textColor="@color/charcoal"
        android:textSize="12sp" />

    <TextView
        style="@style/IreumOnReportHeading"
        android:layout_marginTop="24dp"
        android:text="입력 및 사주 계산 기준" />

    <TextView
        android:id="@+id/textInputBasis"
        style="@style/IreumOnReportBody"
        android:layout_marginTop="8dp"
        android:text="입력 기준" />

    <TextView
        android:id="@+id/textFourPillars"
        style="@style/IreumOnReportBody"
        android:layout_marginTop="6dp"
        android:text="사주 네 기둥" />

    <TextView
        style="@style/IreumOnReportHeading"
        android:layout_marginTop="22dp"
        android:text="한자 뜻" />

    <TextView
        android:id="@+id/textMeaning"
        style="@style/IreumOnReportBody"
        android:layout_marginTop="8dp"
        android:text="한자 뜻" />

    <TextView
        style="@style/IreumOnReportHeading"
        android:layout_marginTop="22dp"
        android:text="획수 수리와 음양" />

    <TextView
        android:id="@+id/textStroke"
        style="@style/IreumOnReportBody"
        android:layout_marginTop="8dp"
        android:text="획수" />

    <TextView
        android:id="@+id/textYinYang"
        style="@style/IreumOnReportBody"
        android:layout_marginTop="7dp"
        android:text="음양" />

    <TextView
        style="@style/IreumOnReportHeading"
        android:layout_marginTop="22dp"
        android:text="사주·이름 오행" />

    <TextView
        android:id="@+id/textFiveElements"
        style="@style/IreumOnReportBody"
        android:layout_marginTop="8dp"
        android:text="오행" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_mint_soft"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/textStrength"
            style="@style/IreumOnReportBody"
            android:text="좋은 점"
            android:textColor="@color/deep_navy"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textWeakness"
            style="@style/IreumOnReportBody"
            android:layout_marginTop="9dp"
            android:text="검토할 점" />
    </LinearLayout>

    <TextView
        android:id="@+id/textCalculationBasis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:lineSpacingExtra="2dp"
        android:text="계산 기준"
        android:textColor="@color/charcoal"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="주의사항"
        android:textColor="@color/charcoal"
        android:textSize="12sp" />
</LinearLayout>
