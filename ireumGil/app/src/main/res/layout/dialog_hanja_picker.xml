<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/paper"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/textHanjaSearchGuide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="한글 음이나 한자를 입력하세요."
        android:textColor="@color/charcoal"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editHanjaSearch"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:hint="예: 민, 서, 珉"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:singleLine="true"
        android:textColor="@color/deep_navy"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnOpenHandwriting"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_primary"
        android:text="손글씨로 한자 찾기"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textResultCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/brand_primary_dark"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textEmptyResult"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:padding="16dp"
        android:text="검색할 한글 음이나 한자를 입력해 주세요."
        android:textColor="@color/charcoal"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/listCandidates"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:divider="#00000000"
        android:dividerHeight="8dp"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="표시 가능한 대한민국 법원 인명용 한자만 제공합니다."
        android:textColor="@color/charcoal"
        android:textSize="12sp" />

</LinearLayout>
