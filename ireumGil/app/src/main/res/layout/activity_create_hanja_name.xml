<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1) 성 한자 선택"
            android:textColor="@color/deep_navy"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editSurname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:hint="탭하여 성 한자 선택"
            android:padding="12dp" />

        <TextView
            android:id="@+id/chipSelectedSurname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:text="선택된 성 한자: 없음"
            android:textColor="@color/soft_red"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="2) 원하는 한글 이름 (선택)"
            android:textColor="@color/deep_navy"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editPreferredName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:hint="예: 서윤 · 비우면 자동 추천"
            android:inputType="textPersonName"
            android:maxLength="2"
            android:padding="14dp"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="입력하면 해당 발음으로 등록 가능한 인명용 한자 조합을 찾아드립니다."
            android:textColor="@color/charcoal"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="3) 생년월일시"
            android:textColor="@color/deep_navy"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPickDate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:text="생년월일 선택"
            android:textAllCaps="false"
            android:textColor="@color/deep_navy"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnPickTime"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:text="태어난 시간 선택"
            android:textAllCaps="false"
            android:textColor="@color/deep_navy"
            android:textSize="16sp" />

        <EditText android:id="@+id/editYear" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <EditText android:id="@+id/editMonth" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <EditText android:id="@+id/editDay" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <EditText android:id="@+id/editHour" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <EditText android:id="@+id/editMinute" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="달력 기준"
            android:textColor="@color/charcoal"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinnerCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:paddingLeft="14dp"
            android:paddingRight="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="성별"
            android:textColor="@color/charcoal"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinnerGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:paddingLeft="14dp"
            android:paddingRight="14dp" />

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_primary"
            android:text="좋은 이름 후보 생성"
            android:textColor="@color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="생년월일시와 선택한 성 한자를 기준으로 이름을 추천합니다"
            android:textColor="@color/charcoal"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textGenderFilterStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:text="성별 구분 없이 추천되었습니다"
            android:textColor="@color/charcoal"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textRecommendationGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="실제 분석 점수 구간별로 추천 이름이 표시됩니다"
            android:textColor="@color/charcoal"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:text="입력 초기화"
            android:textColor="@color/charcoal" />

        <LinearLayout
            android:id="@+id/layoutCandidates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/disclaimer"
            android:textColor="@color/charcoal"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
