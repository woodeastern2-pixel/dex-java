<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollNameAnalysis"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="내 이름에 담긴 뜻과 균형"
            android:textColor="@color/deep_navy"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="성명 한자와 생년월일시를 선택하면 한자 뜻, 획수, 음양과 오행을 한눈에 정리해 드립니다."
            android:textColor="@color/charcoal"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="1. 성명 한자 선택"
            android:textColor="@color/deep_navy"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPickSurname"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_selection_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="성 한자 선택"
            android:textAllCaps="false"
            android:textColor="@color/deep_navy"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnPickFirst"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_selection_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="이름 첫 글자 한자 선택"
            android:textAllCaps="false"
            android:textColor="@color/deep_navy"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnPickSecond"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_selection_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="이름 둘째 글자 한자 선택"
            android:textAllCaps="false"
            android:textColor="@color/deep_navy"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/chipSelectedHanja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip"
            android:padding="10dp"
            android:text="성명 한자 3글자를 차례로 선택해 주세요."
            android:textColor="@color/soft_red"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="2. 생년월일시"
            android:textColor="@color/deep_navy"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPickDate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_selection_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="생년월일 선택"
            android:textAllCaps="false"
            android:textColor="@color/deep_navy"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnPickTime"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_selection_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="태어난 시간 선택"
            android:textAllCaps="false"
            android:textColor="@color/deep_navy"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spinnerCalendar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:paddingLeft="14dp"
            android:paddingRight="14dp" />

        <Spinner
            android:id="@+id/spinnerGender"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:paddingLeft="14dp"
            android:paddingRight="14dp" />

        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@color/brand_primary"
            android:text="이름 풀이 보기"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textAnalysisGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="위 정보를 모두 선택하면 풀이 결과가 이곳에 표시됩니다."
            android:textColor="@color/charcoal"
            android:textSize="13sp" />

        <com.easternwood.ireumgil.ui.ResultReportView
            android:id="@+id/resultReportView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_selection_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="입력 초기화"
            android:textColor="@color/charcoal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/disclaimer"
            android:textColor="@color/charcoal"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
